# Base URL of the dice engine, the local audio service that renders generated
# backing parts (beats, pads, basses, arps).
#
# Leave unset to use the dev proxy at "/engine" (see vite.config.ts), which
# forwards to http://localhost:8000 and avoids CORS in dev.
#
# VITE_DICE_ENGINE_URL=http://localhost:8000
# VITE_DICE_ENGINE_URL=https://my-dice-engine.example.com
#
# VITE_DEEJAI_URL is still read as a fallback, for environments set up before
# the rename.

# Optional endpoint for a model-backed planner for the producer agent. Unset by
# default: the agent's offline planner needs no key and no network. The endpoint
# receives the goal, a description of the session, and the agent's tool schemas,
# and returns one tool call.
#
# VITE_DICE_AGENT_URL=http://localhost:8000/api/agent/plan
